# Auto detect text files and perform LF normalization
* text=auto eol=lf

*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.gz binary
*.tar binary
*.dump binary
*.db binary

# Runtime data is mounted separately from the exact release archive. Keeping
# even placeholder files out of git archive prevents tracked code/config
# extraction from crossing a persistent-data mount boundary.
/projects-portal/state export-ignore
/secrets export-ignore
/traefik/acme export-ignore
/traefik/certs export-ignore
/reports export-ignore
/backups export-ignore
/release export-ignore
/.tmp export-ignore
/security/sbom export-ignore
/security/dast export-ignore
