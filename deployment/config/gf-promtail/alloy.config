loki.process "docker" {
	forward_to = [loki.write.default.receiver]

	stage.docker { }

	stage.drop {
		drop_counter_reason = "stale_docker_log"
		older_than          = "168h0m0s"
	}

	stage.drop {
		drop_counter_reason = "sensitive_http_material"
		expression          = "(?i)\"?(?:request_?body|response_?body|body|authorization|cookie|set-cookie)\"?\\s*[:=]"
	}

	stage.drop {
		drop_counter_reason = "sensitive_structured_value"
		expression = "(?i)\"?(?:password|secret|token|otp|backupCode|backupCodes|credential|challenge)\"?\\s*[:=]\\s*[\\[{]"
	}

	stage.replace {
		expression = "(?i)\"?(?:authorization|cookie|set-cookie|password|secret|token|otp|backupCode|backupCodes|credential|challenge)\"?\\s*[:=]\\s*(\"[^\"\\\\]*(?:\\\\.[^\"\\\\]*)*\"|[^,\\s}]+)"
		replace = "\"[REDACTED]\""
	}

	stage.json {
		expressions = {
			event   = "event",
			level   = "level",
			service = "service",
		}
	}

	stage.labels {
		values = {
			level   = null,
			service = null,
		}
	}
}

loki.source.file "docker" {
	targets = [{
		__address__ = "localhost",
		__path__    = "/var/lib/docker/containers/*/*-json.log",
		job         = "docker",
	}]
	forward_to = [loki.process.docker.receiver]

	file_match {
		enabled = true
	}
	legacy_positions_file = "/var/lib/alloy/positions-legacy.yml"
}

loki.write "default" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
	external_labels = {}
}
