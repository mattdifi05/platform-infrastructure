[Unit]
Description=Verify local DNS and certificate-validated DoH answers
After=network-online.target docker.service
[Service]
Type=oneshot
EnvironmentFile=-/etc/platform-infrastructure/dns-probe.env
ExecStart=/usr/local/libexec/platform-dns-probe.py
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=-/var/lib/platform-infrastructure/node-exporter-textfile
RestrictAddressFamilies=AF_UNIX AF_INET
MemoryMax=64M
TimeoutStartSec=20
