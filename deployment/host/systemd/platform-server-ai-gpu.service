[Unit]
Description=Platform Server AI GPU snapshot
After=local-fs.target

[Service]
Type=oneshot
User=platform_infrastructure
RuntimeDirectory=platform-server-ai
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=0022
ExecStart=/usr/bin/python3 /usr/local/libexec/platform-server-ai-gpu-snapshot.py
TimeoutStartSec=5s
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/platform-server-ai
