+def shared_quota_mutation(action):
+ import functools
+ @functools.wraps(action)
+ def wrapped(*args,**kwargs):
+  global _SHARED_QUOTA_BUDGET,_SHARED_QUOTA_ACTIVE
+  if _SHARED_QUOTA_ACTIVE:return action(*args,**kwargs)
+  module_path=pathlib.Path('/usr/local/libexec/platform_ftps_shared_quota.py')
+  info=module_path.lstat()
+  if module_path.is_symlink() or not stat.S_ISREG(info.st_mode) or info.st_uid!=0 or info.st_mode&0o022 or info.st_nlink!=1 or sha(module_path)!='bbfb7263e0f3fb8bd329bb1d33fc01a3e28e2bcb5952715bfeeba3d1f9b5e493':
+   raise RuntimeError('Shared quota helper code binding differs')
+  quota_spec=importlib.util.spec_from_file_location('ftps_shared_quota',module_path)
+  quota=importlib.util.module_from_spec(quota_spec);quota_spec.loader.exec_module(quota)
+  with quota.writer_budget(CONFIG,FOLDER) as available:
+   _SHARED_QUOTA_BUDGET=available;_SHARED_QUOTA_ACTIVE=True
+   try:return action(*args,**kwargs)
+   finally:_SHARED_QUOTA_BUDGET=CAP;_SHARED_QUOTA_ACTIVE=False
+ return wrapped
