{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.invalid/schemas/cyclonedx-1.5-platform-release.schema.json",
  "title": "Strict Platform release profile for CycloneDX 1.5",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "bomFormat", "specVersion", "serialNumber", "version", "metadata", "components"],
  "properties": {
    "$schema": { "const": "http://cyclonedx.org/schema/bom-1.5.schema.json" },
    "bomFormat": { "const": "CycloneDX" },
    "specVersion": { "const": "1.5" },
    "serialNumber": { "type": "string", "pattern": "^urn:uuid:[0-9a-fA-F-]{36}$" },
    "version": { "type": "integer", "minimum": 1 },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp", "component", "properties"],
      "properties": {
        "timestamp": { "type": "string", "format": "date-time" },
        "component": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "name", "version", "purl"],
          "properties": {
            "type": { "const": "application" },
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "purl": { "type": "string", "pattern": "^pkg:github/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+@[a-f0-9]{40}$" }
          }
        },
        "properties": {
          "type": "array",
          "minItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "value": { "type": "string" }
            }
          }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "name", "version", "hashes", "purl", "properties"],
            "properties": {
              "type": { "const": "container" },
              "name": { "type": "string", "pattern": "^[a-z0-9.-]+(:[0-9]+)?(/[a-z0-9._-]+)+$" },
              "version": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
              "hashes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["alg", "content"],
                  "properties": {
                    "alg": { "const": "SHA-256" },
                    "content": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                  }
                }
              },
              "purl": { "type": "string", "pattern": "^pkg:oci/[a-z0-9.-]+(:[0-9]+)?(/[a-z0-9._-]+)+@sha256:[a-f0-9]{64}$" },
              "properties": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "value"],
                  "properties": {
                    "name": { "const": "releaseSubjectKey" },
                    "value": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "bom-ref", "name", "version", "properties"],
            "properties": {
              "type": { "const": "library" },
              "bom-ref": { "type": "string", "pattern": "^urn:buildkit-spdx:[a-f0-9]{64}$" },
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "purl": { "type": "string", "pattern": "^pkg:\\S+$" },
              "hashes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["alg", "content"],
                  "properties": {
                    "alg": { "const": "SHA-256" },
                    "content": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
                  }
                }
              },
              "properties": {
                "type": "array",
                "minItems": 4,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "value"],
                  "properties": {
                    "name": { "enum": ["sbom.source", "buildkit.platform", "buildkit.spdxId", "releaseSubjectImage"] },
                    "value": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
