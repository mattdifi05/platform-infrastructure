{
  "version": 1,
  "scope": "platform-infrastructure",
  "title": "Enterprise Production 360 Coverage",
  "expectedDomainCount": 16,
  "minimumControlCount": 48,
  "statusSemantics": {
    "covered": "The control exists in repository governance and has a mapped evidence source.",
    "passed": "The coverage catalog is complete. This is not a production go-live decision.",
    "pending-live-proof": "The control is covered, but the real environment evidence still has to pass.",
    "provider-required": "The control requires an external provider, public endpoint or third-party system.",
    "human-required": "The control requires human approval, external audit or professional assessment."
  },
  "domains": [
