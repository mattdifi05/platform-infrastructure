        {
          "id": "ubuntu-lts-hardening",
          "title": "Ubuntu LTS hardening, SSH and firewall",
          "mode": "protected-runtime",
          "requiredBeforeGoLive": true,
          "evidenceRefs": ["enterprise:vps-hardening-firewall-fail2ban", "readiness:firewall-fail2ban", "file:scripts/vps-hardening-ubuntu.sh", "file:scripts/vps-host-readiness.sh"]
