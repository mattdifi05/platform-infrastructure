{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.example.invalid/schemas/v1-phase-b-bootstrap-execution-receipt.schema.json",
  "title": "V1 Phase-B native bootstrap execution receipt bytes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "activationPerformed", "binding", "claimArtifactSha256", "claimCreatedAt", "claimSizeBytes",
    "claimWrite", "consumedAt", "dataRollbackAuthority", "failureTerminal", "firstNonClaimMutationAt",
    "firstWritePath", "journalArtifactSha256", "journalEntryCount", "journalRecordSizeBytes",
    "journalRecordWrittenAt", "journalWrite", "mutationScope", "receiptPreparedAt",
    "receiptWriteRequirements", "replayRejected", "resumeAllowed", "rollbackAttempted", "schema",
    "sequence", "state", "terminalArtifactSha256"
  ],
  "properties": {
    "schema": { "const": "platform.v1-phase-b-bootstrap-execution-receipt/v1" },
    "activationPerformed": { "const": false },
    "binding": { "$ref": "#/$defs/binding" },
    "claimArtifactSha256": { "$ref": "#/$defs/sha256" },
    "claimCreatedAt": { "$ref": "#/$defs/timestamp" },
    "claimSizeBytes": { "$ref": "#/$defs/positiveInteger" },
    "claimWrite": {
      "type": "object", "additionalProperties": false,
      "required": [
        "atomicCreateExclusive", "descriptorNoFollow", "fileFsyncCompleted", "objectIdentity",
        "parentFsyncCompleted"
      ],
      "properties": {
        "atomicCreateExclusive": { "const": true },
        "descriptorNoFollow": { "const": true },
        "fileFsyncCompleted": { "const": true },
        "objectIdentity": { "$ref": "#/$defs/materializedIdentity" },
        "parentFsyncCompleted": { "const": true }
      }
    },
    "consumedAt": { "$ref": "#/$defs/timestamp" },
    "dataRollbackAuthority": { "const": false },
    "failureTerminal": { "const": true },
    "firstNonClaimMutationAt": { "$ref": "#/$defs/timestamp" },
    "firstWritePath": { "type": "string", "pattern": "^/var/lib/\\.platform-v1-phase-b-claim-[a-f0-9]{64}$" },
    "journalArtifactSha256": { "$ref": "#/$defs/sha256" },
    "journalEntryCount": { "type": "integer", "minimum": 1, "maximum": 4096 },
    "journalRecordSizeBytes": { "$ref": "#/$defs/positiveInteger" },
    "journalRecordWrittenAt": { "$ref": "#/$defs/timestamp" },
    "journalWrite": {
      "type": "object", "additionalProperties": false,
      "required": [
        "appendOnly", "createdExclusive", "descriptorNoFollow", "fileFsyncCompleted",
        "journalNegativeLookupReceiptSha256", "journalParentIdentitySha256", "objectIdentity",
        "parentFsyncCompleted"
      ],
      "properties": {
        "appendOnly": { "const": true },
        "createdExclusive": { "const": true },
        "descriptorNoFollow": { "const": true },
        "fileFsyncCompleted": { "const": true },
        "journalNegativeLookupReceiptSha256": { "$ref": "#/$defs/sha256" },
        "journalParentIdentitySha256": { "$ref": "#/$defs/sha256" },
        "objectIdentity": { "$ref": "#/$defs/materializedIdentity" },
        "parentFsyncCompleted": { "const": true }
      }
    },
    "mutationScope": { "const": "PINNED_CONTROL_PLANE_INSTALL_ONLY" },
    "receiptPreparedAt": { "$ref": "#/$defs/timestamp" },
    "receiptWriteRequirements": {
      "type": "object", "additionalProperties": false,
      "required": [
        "createdExclusiveRequired", "descriptorNoFollowRequired", "fileFsyncRequired", "openFlags",
        "parentFsyncRequired", "receiptNegativeLookupReceiptSha256", "receiptParentIdentitySha256"
      ],
      "properties": {
        "createdExclusiveRequired": { "const": true },
        "descriptorNoFollowRequired": { "const": true },
        "fileFsyncRequired": { "const": true },
        "openFlags": {
          "type": "array", "prefixItems": [
            { "const": "O_CREAT" }, { "const": "O_EXCL" },
            { "const": "O_NOFOLLOW" }, { "const": "O_WRONLY" }
          ], "items": false, "minItems": 4, "maxItems": 4
        },
        "parentFsyncRequired": { "const": true },
        "receiptNegativeLookupReceiptSha256": { "$ref": "#/$defs/sha256" },
        "receiptParentIdentitySha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "replayRejected": { "const": true },
    "resumeAllowed": { "const": false },
    "rollbackAttempted": { "const": false },
    "sequence": { "type": "integer", "minimum": 3, "maximum": 4098 },
    "state": { "enum": ["FAILED_TERMINAL", "INSTALLED_NON_ACTIVATING"] },
    "terminalArtifactSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/sha256" },
    "nonce": { "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/nonce" },
    "positiveInteger": { "type": "integer", "minimum": 1, "maximum": 4194304 },
    "positiveDecimal": { "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/positiveDecimal" },
    "identifier": { "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/identifier" },
    "opaqueIdentifier": { "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/opaqueIdentifier" },
    "timestamp": { "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/timestamp" },
    "materializedIdentity": {
      "type": "object", "additionalProperties": false,
      "required": [
        "descriptorNoFollow", "deviceIdentity", "fileType", "filesystemUuid", "gid",
        "identityReceiptSha256", "inode", "kind", "mode", "mountId", "nlink", "path",
        "sha256", "sizeBytes", "symlink", "uid"
      ],
      "properties": {
        "descriptorNoFollow": { "const": true },
        "deviceIdentity": { "$ref": "#/$defs/identifier" },
        "fileType": { "const": "REGULAR_FILE" },
        "filesystemUuid": { "$ref": "#/$defs/sha256" },
        "gid": { "const": 0 },
        "identityReceiptSha256": { "$ref": "#/$defs/sha256" },
        "inode": { "$ref": "#/$defs/positiveDecimal" },
        "kind": { "enum": ["LEDGER_RECORD", "REPLAY_CLAIM"] },
        "mode": { "const": "0400" },
        "mountId": { "$ref": "#/$defs/positiveDecimal" },
        "nlink": { "const": 1 },
        "path": { "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/absolutePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "sizeBytes": { "$ref": "#/$defs/positiveInteger" },
        "symlink": { "const": false },
        "uid": { "const": 0 }
      }
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": [
        "authorizationEnvelopeSha256", "authorizationExpiresAt", "authorizationId", "authorizationIssuedAt",
        "claimId", "claimObjectPath", "journalParentIdentitySha256", "journalRecordPath", "journalStorePath",
        "ledgerEntryKeySha256", "ledgerId", "ledgerParentPath", "nonce", "packageBytesSha256",
        "packageInputObservationSha256", "packageManifestSha256", "policySha256",
        "preinstallTupleSha256", "receiptId", "receiptObjectKeySha256", "receiptObjectPath", "receiptStorePath", "transactionId"
      ],
      "properties": {
        "authorizationEnvelopeSha256": { "$ref": "#/$defs/sha256" },
        "authorizationExpiresAt": { "$ref": "#/$defs/timestamp" },
        "authorizationId": { "$ref": "#/$defs/opaqueIdentifier" },
        "authorizationIssuedAt": { "$ref": "#/$defs/timestamp" },
        "claimId": { "$ref": "#/$defs/identifier" },
        "claimObjectPath": { "type": "string", "pattern": "^/var/lib/\\.platform-v1-phase-b-claim-[a-f0-9]{64}$" },
        "journalParentIdentitySha256": { "$ref": "#/$defs/sha256" },
        "journalRecordPath": { "type": "string", "pattern": "^/var/lib/platform-infrastructure/v1-phase-b-ledger/[a-f0-9]{64}\\.json$" },
        "journalStorePath": { "const": "/var/lib/platform-infrastructure/v1-phase-b-ledger" },
        "ledgerEntryKeySha256": { "$ref": "#/$defs/sha256" },
        "ledgerId": { "const": "platform-v1-phase-b-installer-ledger" },
        "ledgerParentPath": { "const": "/var/lib" },
        "nonce": { "$ref": "#/$defs/nonce" },
        "packageBytesSha256": { "$ref": "#/$defs/sha256" },
        "packageInputObservationSha256": { "$ref": "#/$defs/sha256" },
        "packageManifestSha256": { "$ref": "#/$defs/sha256" },
        "policySha256": { "$ref": "#/$defs/sha256" },
        "preinstallTupleSha256": { "$ref": "#/$defs/sha256" },
        "receiptId": { "$ref": "#/$defs/opaqueIdentifier" },
        "receiptObjectKeySha256": { "$ref": "#/$defs/sha256" },
        "receiptObjectPath": { "type": "string", "pattern": "^/var/lib/platform-infrastructure/v1-install-receipts/sha256/[a-f0-9]{64}\\.json$" },
        "receiptStorePath": { "const": "/var/lib/platform-infrastructure/v1-install-receipts/sha256" },
        "transactionId": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
