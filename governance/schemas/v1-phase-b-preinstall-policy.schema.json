{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.example.invalid/schemas/v1-phase-b-preinstall-policy.schema.json",
  "title": "V1 Phase-B PREINSTALL verification policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authoritativeEvidence",
    "backupTrustPolicySha256",
    "externallyManaged",
    "freshness",
    "installPlanSchema",
    "installPlanSchemaSha256",
    "localMutationAuthority",
    "localTemplate",
    "payloadTypes",
    "reason",
    "replayDomain",
    "roles",
    "schema",
    "selfAssertedEvidenceAccepted",
    "status",
    "trustAnchorProvenance",
    "version"
  ],
  "properties": {
    "schema": {
      "const": "platform.v1-phase-b-preinstall-policy/v1"
    },
    "version": {
      "const": 1
    },
    "status": {
      "enum": [
        "EXTERNAL-PENDING",
        "READY"
      ]
    },
    "externallyManaged": {
      "const": true
    },
    "localTemplate": {
      "type": "boolean"
    },
    "selfAssertedEvidenceAccepted": {
      "const": false
    },
    "authoritativeEvidence": {
      "const": false
    },
    "localMutationAuthority": {
      "const": false
    },
    "trustAnchorProvenance": {
      "enum": [
        "NOT_CONFIGURED",
        "CALLER-SUPPLIED-NON-AUTHORITATIVE"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 20
    },
    "payloadTypes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backupAttestation",
        "phaseAAuthorization",
        "phaseAPackageAttestation",
        "phaseBPreinstallAuthorization"
      ],
      "properties": {
        "backupAttestation": {
          "const": "application/vnd.platform.v1-authoritative-backup-attestation.v1+json"
        },
        "phaseAAuthorization": {
          "const": "application/vnd.platform.v1.phase-a.read-only-authorization.v1+json"
        },
        "phaseAPackageAttestation": {
          "const": "application/vnd.platform.v1.phase-a.package-attestation.v1+json"
        },
        "phaseBPreinstallAuthorization": {
          "const": "application/vnd.platform.v1.phase-b.preinstall-authorization.v1+json"
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxBackupEvidenceAgeSeconds",
        "maxBaselineToBackupLagSeconds",
        "maxClockSkewSeconds",
        "maxLifetimeSeconds"
      ],
      "properties": {
        "maxBackupEvidenceAgeSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 14400
        },
        "maxBaselineToBackupLagSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 14400
        },
        "maxClockSkewSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "maxLifetimeSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 900
        }
      }
    },
    "replayDomain": {
      "const": "phase-b-exact-preinstall/platform-infrastructure/v1"
    },
    "backupTrustPolicySha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "installPlanSchema": {
      "const": "platform.v1-phase-b-install-plan/v2"
    },
    "installPlanSchemaSha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "roles": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "EXTERNAL-PENDING"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "localTemplate": {
            "const": true
          },
          "trustAnchorProvenance": {
            "const": "NOT_CONFIGURED"
          },
          "backupTrustPolicySha256": {
            "type": "null"
          },
          "installPlanSchemaSha256": {
            "type": "null"
          },
          "roles": {
            "$ref": "#/$defs/pendingRoles"
          }
        },
        "type": "object"
      },
      "else": {
        "properties": {
          "localTemplate": {
            "const": false
          },
          "trustAnchorProvenance": {
            "const": "CALLER-SUPPLIED-NON-AUTHORITATIVE"
          },
          "backupTrustPolicySha256": {
            "$ref": "#/$defs/sha256"
          },
          "installPlanSchemaSha256": {
            "$ref": "#/$defs/sha256"
          },
          "roles": {
            "$ref": "#/$defs/readyRoles"
          }
        },
        "type": "object"
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,255}$"
    },
    "jobName": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,127}$"
    },
    "positiveDecimal": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]|900719925474099[0-1])$"
    },
    "repository": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256,
      "pattern": "^[a-z0-9_.-]+/[a-z0-9_.-]+$"
    },
    "workflowPath": {
      "type": "string",
      "minLength": 22,
      "maxLength": 256,
      "pattern": "^\\.github/workflows/[A-Za-z0-9_.-]+\\.ya?ml$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "roleName": {
      "enum": [
        "activationGate",
        "activationTargetRoot",
        "admissionController",
        "backupAuthority",
        "deploymentGate",
        "hostedGate",
        "packageAttestor",
        "phaseAAuthorizationProvider",
        "phaseBInstaller",
        "sourceTargetCustodian"
      ]
    },
    "pendingRole": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "keyId",
        "producerConstraints",
        "publicKeySpkiPem",
        "role"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/roleName"
        },
        "algorithm": {
          "const": "Ed25519"
        },
        "keyId": {
          "type": "null"
        },
        "publicKeySpkiPem": {
          "type": "null"
        },
        "producerConstraints": {
          "type": "null"
        }
      }
    },
    "readyExternalRole": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "keyId",
        "producerConstraints",
        "publicKeySpkiPem",
        "role"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/roleName"
        },
        "algorithm": {
          "const": "Ed25519"
        },
        "keyId": {
          "$ref": "#/$defs/sha256"
        },
        "publicKeySpkiPem": {
          "type": "string",
          "pattern": "^-----BEGIN PUBLIC KEY-----\\n"
        },
        "producerConstraints": {
          "$ref": "#/$defs/externalConstraints"
        }
      }
    },
    "readyTargetRole": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "keyId",
        "producerConstraints",
        "publicKeySpkiPem",
        "role"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/roleName"
        },
        "algorithm": {
          "const": "Ed25519"
        },
        "keyId": {
          "$ref": "#/$defs/sha256"
        },
        "publicKeySpkiPem": {
          "type": "string",
          "pattern": "^-----BEGIN PUBLIC KEY-----\\n"
        },
        "producerConstraints": {
          "$ref": "#/$defs/targetConstraints"
        }
      }
    },
    "externalConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventName",
        "jobName",
        "jobWorkflowSha",
        "protectedEnvironment",
        "ref",
        "repository",
        "repositoryId",
        "repositoryOwnerId",
        "role",
        "type",
        "workflowPath"
      ],
      "properties": {
        "type": {
          "const": "EXTERNAL-CI"
        },
        "role": {
          "$ref": "#/$defs/roleName"
        },
        "repository": {
          "$ref": "#/$defs/repository"
        },
        "repositoryId": {
          "$ref": "#/$defs/positiveDecimal"
        },
        "repositoryOwnerId": {
          "$ref": "#/$defs/positiveDecimal"
        },
        "workflowPath": {
          "$ref": "#/$defs/workflowPath"
        },
        "jobWorkflowSha": {
          "$ref": "#/$defs/gitSha"
        },
        "ref": {
          "const": "refs/heads/main"
        },
        "eventName": {
          "const": "workflow_dispatch"
        },
        "jobName": {
          "$ref": "#/$defs/jobName"
        },
        "protectedEnvironment": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "targetConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint",
        "machineIdentitySha256",
        "role",
        "rootAbsenceReceiptSha256",
        "rootFilesystemIdentitySha256",
        "rootIdentitySha256",
        "rootParentIdentitySha256",
        "rootState",
        "targetId",
        "targetRoot",
        "type"
      ],
      "properties": {
        "type": {
          "const": "TARGET-ROOT"
        },
        "role": {
          "$ref": "#/$defs/roleName"
        },
        "endpoint": {
          "type": "string",
          "minLength": 10,
          "maxLength": 320,
          "pattern": "^ssh://[a-z_][a-z0-9_-]{0,31}@(?!-)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?:(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$"
        },
        "machineIdentitySha256": {
          "$ref": "#/$defs/sha256"
        },
        "rootAbsenceReceiptSha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "rootFilesystemIdentitySha256": {
          "$ref": "#/$defs/sha256"
        },
        "rootIdentitySha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "rootParentIdentitySha256": {
          "$ref": "#/$defs/sha256"
        },
        "rootState": {
          "enum": [
            "ABSENT_PROVEN",
            "EXISTING_EXACT"
          ]
        },
        "targetId": {
          "$ref": "#/$defs/identifier"
        },
        "targetRoot": {
          "type": "string",
          "minLength": 2,
          "maxLength": 4096,
          "pattern": "^/((?!\\.{1,2}(?:/|$))[A-Za-z0-9._-]+)(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9._-]+)*$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "rootState": {
                "const": "ABSENT_PROVEN"
              }
            },
            "required": [
              "rootState"
            ],
            "type": "object"
          },
          "then": {
            "properties": {
              "rootAbsenceReceiptSha256": {
                "$ref": "#/$defs/sha256"
              },
              "rootIdentitySha256": {
                "type": "null"
              }
            },
            "type": "object"
          },
          "else": {
            "properties": {
              "rootAbsenceReceiptSha256": {
                "type": "null"
              },
              "rootIdentitySha256": {
                "$ref": "#/$defs/sha256"
              }
            },
            "type": "object"
          }
        }
      ]
    },
    "pendingRoles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activationGate",
        "activationTargetRoot",
        "admissionController",
        "backupAuthority",
        "deploymentGate",
        "hostedGate",
        "packageAttestor",
        "phaseAAuthorizationProvider",
        "phaseBInstaller",
        "sourceTargetCustodian"
      ],
      "properties": {
        "activationGate": {
          "$ref": "#/$defs/pendingActivationGate"
        },
        "activationTargetRoot": {
          "$ref": "#/$defs/pendingActivationTargetRoot"
        },
        "admissionController": {
          "$ref": "#/$defs/pendingAdmissionController"
        },
        "backupAuthority": {
          "$ref": "#/$defs/pendingBackupAuthority"
        },
        "deploymentGate": {
          "$ref": "#/$defs/pendingDeploymentGate"
        },
        "hostedGate": {
          "$ref": "#/$defs/pendingHostedGate"
        },
        "packageAttestor": {
          "$ref": "#/$defs/pendingPackageAttestor"
        },
        "phaseAAuthorizationProvider": {
          "$ref": "#/$defs/pendingPhaseAAuthorizationProvider"
        },
        "phaseBInstaller": {
          "$ref": "#/$defs/pendingPhaseBInstaller"
        },
        "sourceTargetCustodian": {
          "$ref": "#/$defs/pendingSourceTargetCustodian"
        }
      }
    },
    "readyRoles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activationGate",
        "activationTargetRoot",
        "admissionController",
        "backupAuthority",
        "deploymentGate",
        "hostedGate",
        "packageAttestor",
        "phaseAAuthorizationProvider",
        "phaseBInstaller",
        "sourceTargetCustodian"
      ],
      "properties": {
        "activationGate": {
          "$ref": "#/$defs/readyActivationGate"
        },
        "activationTargetRoot": {
          "$ref": "#/$defs/readyActivationTargetRoot"
        },
        "admissionController": {
          "$ref": "#/$defs/readyAdmissionController"
        },
        "backupAuthority": {
          "$ref": "#/$defs/readyBackupAuthority"
        },
        "deploymentGate": {
          "$ref": "#/$defs/readyDeploymentGate"
        },
        "hostedGate": {
          "$ref": "#/$defs/readyHostedGate"
        },
        "packageAttestor": {
          "$ref": "#/$defs/readyPackageAttestor"
        },
        "phaseAAuthorizationProvider": {
          "$ref": "#/$defs/readyPhaseAAuthorizationProvider"
        },
        "phaseBInstaller": {
          "$ref": "#/$defs/readyPhaseBInstaller"
        },
        "sourceTargetCustodian": {
          "$ref": "#/$defs/readySourceTargetCustodian"
        }
      }
    },
    "pendingActivationGate": {
      "allOf": [
        {
          "$ref": "#/$defs/pendingRole"
        },
        {
          "properties": {
            "role": {
              "const": "activationGate"
            }
          },
          "type": "object"
        }
      ]
    },
    "pendingActivationTargetRoot": {
      "allOf": [
        {
          "$ref": "#/$defs/pendingRole"
        },
        {
          "properties": {
            "role": {
              "const": "activationTargetRoot"
            }
          },
          "type": "object"
        }
      ]
    },
    "pendingAdmissionController": {
      "allOf": [
        {
          "$ref": "#/$defs/pendingRole"
        },
        {
          "properties": {
            "role": {
              "const": "admissionController"
            }
          },
          "type": "object"
        }
      ]
    },
    "pendingBackupAuthority": {
      "allOf": [
        {
          "$ref": "#/$defs/pendingRole"
        },
        {
          "properties": {
            "role": {
              "const": "backupAuthority"
            }
          },
          "type": "object"
        }
      ]
    },
    "pendingDeploymentGate": {
      "allOf": [
        {
          "$ref": "#/$defs/pendingRole"
        },
        {
          "properties": {
            "role": {
              "const": "deploymentGate"
            }
          },
          "type": "object"
        }
      ]
    },
    "pendingHostedGate": {
      "allOf": [
        {
          "$ref": "#/$defs/pendingRole"
        },
        {
          "properties": {
            "role": {
              "const": "hostedGate"
            }
          },
          "type": "object"
        }
      ]
    },
    "pendingPackageAttestor": {
      "allOf": [
        {
          "$ref": "#/$defs/pendingRole"
        },
        {
          "properties": {
            "role": {
              "const": "packageAttestor"
            }
          },
          "type": "object"
        }
      ]
    },
    "pendingPhaseAAuthorizationProvider": {
      "allOf": [
        {
          "$ref": "#/$defs/pendingRole"
        },
        {
          "properties": {
            "role": {
              "const": "phaseAAuthorizationProvider"
            }
          },
          "type": "object"
        }
      ]
    },
    "pendingPhaseBInstaller": {
      "allOf": [
        {
          "$ref": "#/$defs/pendingRole"
        },
        {
          "properties": {
            "role": {
              "const": "phaseBInstaller"
            }
          },
          "type": "object"
        }
      ]
    },
    "pendingSourceTargetCustodian": {
      "allOf": [
        {
          "$ref": "#/$defs/pendingRole"
        },
        {
          "properties": {
            "role": {
              "const": "sourceTargetCustodian"
            }
          },
          "type": "object"
        }
      ]
    },
    "readyActivationGate": {
      "allOf": [
        {
          "$ref": "#/$defs/readyExternalRole"
        },
        {
          "properties": {
            "role": {
              "const": "activationGate"
            },
            "producerConstraints": {
              "properties": {
                "role": {
                  "const": "activationGate"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        }
      ]
    },
    "readyActivationTargetRoot": {
      "allOf": [
        {
          "$ref": "#/$defs/readyTargetRole"
        },
        {
          "properties": {
            "role": {
              "const": "activationTargetRoot"
            },
            "producerConstraints": {
              "properties": {
                "role": {
                  "const": "activationTargetRoot"
                },
                "rootState": {
                  "const": "ABSENT_PROVEN"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        }
      ]
    },
    "readyAdmissionController": {
      "allOf": [
        {
          "$ref": "#/$defs/readyExternalRole"
        },
        {
          "properties": {
            "role": {
              "const": "admissionController"
            },
            "producerConstraints": {
              "properties": {
                "role": {
                  "const": "admissionController"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        }
      ]
    },
    "readyBackupAuthority": {
      "allOf": [
        {
          "$ref": "#/$defs/readyExternalRole"
        },
        {
          "properties": {
            "role": {
              "const": "backupAuthority"
            },
            "producerConstraints": {
              "properties": {
                "role": {
                  "const": "backupAuthority"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        }
      ]
    },
    "readyDeploymentGate": {
      "allOf": [
        {
          "$ref": "#/$defs/readyExternalRole"
        },
        {
          "properties": {
            "role": {
              "const": "deploymentGate"
            },
            "producerConstraints": {
              "properties": {
                "role": {
                  "const": "deploymentGate"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        }
      ]
    },
    "readyHostedGate": {
      "allOf": [
        {
          "$ref": "#/$defs/readyExternalRole"
        },
        {
          "properties": {
            "role": {
              "const": "hostedGate"
            },
            "producerConstraints": {
              "properties": {
                "role": {
                  "const": "hostedGate"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        }
      ]
    },
    "readyPackageAttestor": {
      "allOf": [
        {
          "$ref": "#/$defs/readyExternalRole"
        },
        {
          "properties": {
            "role": {
              "const": "packageAttestor"
            },
            "producerConstraints": {
              "properties": {
                "role": {
                  "const": "packageAttestor"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        }
      ]
    },
    "readyPhaseAAuthorizationProvider": {
      "allOf": [
        {
          "$ref": "#/$defs/readyExternalRole"
        },
        {
          "properties": {
            "role": {
              "const": "phaseAAuthorizationProvider"
            },
            "producerConstraints": {
              "properties": {
                "role": {
                  "const": "phaseAAuthorizationProvider"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        }
      ]
    },
    "readyPhaseBInstaller": {
      "allOf": [
        {
          "$ref": "#/$defs/readyExternalRole"
        },
        {
          "properties": {
            "role": {
              "const": "phaseBInstaller"
            },
            "producerConstraints": {
              "properties": {
                "role": {
                  "const": "phaseBInstaller"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        }
      ]
    },
    "readySourceTargetCustodian": {
      "allOf": [
        {
          "$ref": "#/$defs/readyTargetRole"
        },
        {
          "properties": {
            "role": {
              "const": "sourceTargetCustodian"
            },
            "producerConstraints": {
              "properties": {
                "role": {
                  "const": "sourceTargetCustodian"
                },
                "rootState": {
                  "const": "EXISTING_EXACT"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        }
      ]
    }
  }
}
