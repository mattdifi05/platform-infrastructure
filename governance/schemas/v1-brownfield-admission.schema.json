{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:platform-infrastructure:schema:v1-brownfield-admission:v1",
  "title": "V1 brownfield aggregate admission DSSE payload",
  "description": "Dual-signed aggregate binding the fixed HOSTED, DEPLOYMENT, ACTIVATION sequence. Local verification remains non-authoritative.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "admissionId", "backupAttestationEnvelopeSha256", "dataRollbackAuthority", "decision", "expiresAt", "gates",
    "issuedAt", "policySha256", "producers", "schema", "tuple", "tupleSha256"
  ],
  "properties": {
    "admissionId": {
      "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/sha256"
    },
    "backupAttestationEnvelopeSha256": {
      "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/sha256"
    },
    "dataRollbackAuthority": { "const": false },
    "decision": { "const": "PASS" },
    "expiresAt": {
      "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/timestamp"
    },
    "gates": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        { "$ref": "#/$defs/hostedGateRef" },
        { "$ref": "#/$defs/deploymentGateRef" },
        { "$ref": "#/$defs/activationGateRef" }
      ],
      "items": false
    },
    "issuedAt": {
      "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/timestamp"
    },
    "policySha256": {
      "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/sha256"
    },
    "producers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activationTargetRoot", "admissionController"],
      "properties": {
        "activationTargetRoot": {
          "allOf": [
            { "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/targetRootProducer" },
            { "type": "object", "properties": {
              "role": { "const": "activationTargetRoot" },
              "rootState": { "const": "EXISTING_EXACT" }
            } }
          ]
        },
        "admissionController": {
          "allOf": [
            { "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/externalProducer" },
            { "type": "object", "properties": { "role": { "const": "admissionController" } } }
          ]
        }
      }
    },
    "schema": { "const": "platform.v1-brownfield-admission/v1" },
    "tuple": {
      "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/commonTuple"
    },
    "tupleSha256": {
      "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/sha256"
    }
  },
  "$defs": {
    "gateRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "admissionId", "envelopeSha256", "gate", "legacyArtifactSetSha256", "payloadSha256", "payloadType",
        "role", "rootKeyFingerprintSha256"
      ],
      "properties": {
        "admissionId": {
          "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/sha256"
        },
        "envelopeSha256": {
          "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/sha256"
        },
        "gate": { "enum": ["HOSTED", "DEPLOYMENT", "ACTIVATION"] },
        "legacyArtifactSetSha256": {
          "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/sha256"
        },
        "payloadSha256": {
          "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/sha256"
        },
        "payloadType": {
          "enum": [
            "application/vnd.platform.v1-brownfield-gate-admission.hosted.v1+json",
            "application/vnd.platform.v1-brownfield-gate-admission.deployment.v1+json",
            "application/vnd.platform.v1-brownfield-gate-admission.activation.v1+json"
          ]
        },
        "role": { "enum": ["hostedGate", "deploymentGate", "activationGate"] },
        "rootKeyFingerprintSha256": {
          "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/sha256"
        }
      }
    },
    "hostedGateRef": {
      "allOf": [
        { "$ref": "#/$defs/gateRef" },
        { "type": "object", "properties": {
          "gate": { "const": "HOSTED" },
          "payloadType": { "const": "application/vnd.platform.v1-brownfield-gate-admission.hosted.v1+json" },
          "role": { "const": "hostedGate" }
        } }
      ]
    },
    "deploymentGateRef": {
      "allOf": [
        { "$ref": "#/$defs/gateRef" },
        { "type": "object", "properties": {
          "gate": { "const": "DEPLOYMENT" },
          "payloadType": { "const": "application/vnd.platform.v1-brownfield-gate-admission.deployment.v1+json" },
          "role": { "const": "deploymentGate" }
        } }
      ]
    },
    "activationGateRef": {
      "allOf": [
        { "$ref": "#/$defs/gateRef" },
        { "type": "object", "properties": {
          "gate": { "const": "ACTIVATION" },
          "payloadType": { "const": "application/vnd.platform.v1-brownfield-gate-admission.activation.v1+json" },
          "role": { "const": "activationGate" }
        } }
      ]
    }
  }
}
