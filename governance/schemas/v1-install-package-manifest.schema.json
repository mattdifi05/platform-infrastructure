{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.example.invalid/schemas/v1-install-package-manifest.schema.json",
  "title": "V1 raw concatenated install package manifest",
  "description": "Closed, non-authoritative byte-layout description for the six fixed V1 control-plane package members.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "members",
    "packageSha256",
    "packageSizeBytes",
    "schema"
  ],
  "properties": {
    "format": { "const": "RAW-CONCATENATED-MEMBERS/V1" },
    "members": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        {
          "allOf": [
            { "$ref": "#/$defs/member" },
            { "type": "object", "properties": {
              "destination": { "const": "/usr/local/libexec/platform-activation-broker" },
              "index": { "const": 0 },
              "kind": { "const": "EXECUTABLE" },
              "mode": { "const": "0555" },
              "packageMember": { "const": "bin/platform-activation-broker" }
            } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/member" },
            { "type": "object", "properties": {
              "destination": { "const": "/usr/local/libexec/platform-v1-brownfield-admission" },
              "index": { "const": 1 },
              "kind": { "const": "EXECUTABLE" },
              "mode": { "const": "0555" },
              "packageMember": { "const": "bin/platform-v1-brownfield-admission" }
            } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/member" },
            { "type": "object", "properties": {
              "destination": { "const": "/usr/local/libexec/platform-hosted-preparation-broker" },
              "index": { "const": 2 },
              "kind": { "const": "EXECUTABLE" },
              "mode": { "const": "0555" },
              "packageMember": { "const": "bin/platform-hosted-preparation-broker" }
            } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/member" },
            { "type": "object", "properties": {
              "destination": { "const": "/usr/local/libexec/platform-origin-firewall" },
              "index": { "const": 3 },
              "kind": { "const": "EXECUTABLE" },
              "mode": { "const": "0555" },
              "packageMember": { "const": "bin/platform-origin-firewall" }
            } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/member" },
            { "type": "object", "properties": {
              "destination": { "const": "/usr/local/libexec/platform-workload-egress-firewall" },
              "index": { "const": 4 },
              "kind": { "const": "EXECUTABLE" },
              "mode": { "const": "0555" },
              "packageMember": { "const": "bin/platform-workload-egress-firewall" }
            } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/member" },
            { "type": "object", "properties": {
              "destination": { "const": "/etc/sudoers.d/platform-activation-broker" },
              "index": { "const": 5 },
              "kind": { "const": "SUDOERS" },
              "mode": { "const": "0440" },
              "packageMember": { "const": "etc/sudoers.d/platform-activation-broker" }
            } }
          ]
        }
      ],
      "items": false
    },
    "packageSha256": { "$ref": "#/$defs/sha256" },
    "packageSizeBytes": {
      "type": "integer",
      "minimum": 6,
      "maximum": 4194304
    },
    "schema": { "const": "platform.v1-install-package-manifest/v1" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "destination",
        "gid",
        "index",
        "kind",
        "mode",
        "nlink",
        "offset",
        "packageMember",
        "sha256",
        "sizeBytes",
        "uid",
        "version"
      ],
      "properties": {
        "destination": { "type": "string" },
        "gid": { "const": 0 },
        "index": { "type": "integer", "minimum": 0, "maximum": 5 },
        "kind": { "enum": ["EXECUTABLE", "SUDOERS"] },
        "mode": { "enum": ["0440", "0555"] },
        "nlink": { "const": 1 },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4194303
        },
        "packageMember": { "type": "string" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        },
        "uid": { "const": 0 },
        "version": { "const": 1 }
      }
    }
  }
}
