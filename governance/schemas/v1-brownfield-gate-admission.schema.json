{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:platform-infrastructure:schema:v1-brownfield-gate-admission:v1",
  "title": "V1 brownfield role-specific gate admission DSSE payload",
  "description": "Closed post-install gate payload over the final tuple. Schema validation alone is non-authoritative.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "admissionId", "backupAttestationEnvelopeSha256", "dataRollbackAuthority", "decision", "expiresAt",
    "externalEvidence", "gate", "issuedAt", "legacyArtifactHashes", "policySha256", "predecessor", "producer",
    "schema", "tuple", "tupleSha256"
  ],
  "properties": {
    "admissionId": {
      "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/sha256"
    },
    "backupAttestationEnvelopeSha256": {
      "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/sha256"
    },
    "dataRollbackAuthority": { "const": false },
    "decision": { "const": "PASS" },
    "expiresAt": {
      "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/timestamp"
    },
    "externalEvidence": { "const": true },
    "gate": { "enum": ["HOSTED", "DEPLOYMENT", "ACTIVATION"] },
    "issuedAt": {
      "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/timestamp"
    },
    "legacyArtifactHashes": {
      "oneOf": [
        { "$ref": "#/$defs/hostedLegacy" },
        { "$ref": "#/$defs/deploymentLegacy" },
        { "$ref": "#/$defs/activationLegacy" }
      ]
    },
    "policySha256": {
      "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/sha256"
    },
    "predecessor": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/predecessor" }
      ]
    },
    "producer": {
      "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/externalProducer"
    },
    "schema": { "const": "platform.v1-brownfield-gate-admission/v1" },
    "tuple": {
      "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/commonTuple"
    },
    "tupleSha256": {
      "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": { "type": "object", "properties": { "gate": { "const": "HOSTED" } }, "required": ["gate"] },
      "then": {
        "type": "object",
        "properties": {
          "legacyArtifactHashes": { "$ref": "#/$defs/hostedLegacy" },
          "predecessor": { "type": "null" },
          "producer": {
            "allOf": [
              { "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/externalProducer" },
              { "type": "object", "properties": { "role": { "const": "hostedGate" } } }
            ]
          }
        }
      }
    },
    {
      "if": { "type": "object", "properties": { "gate": { "const": "DEPLOYMENT" } }, "required": ["gate"] },
      "then": {
        "type": "object",
        "properties": {
          "legacyArtifactHashes": { "$ref": "#/$defs/deploymentLegacy" },
          "predecessor": { "$ref": "#/$defs/hostedPredecessor" },
          "producer": {
            "allOf": [
              { "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/externalProducer" },
              { "type": "object", "properties": { "role": { "const": "deploymentGate" } } }
            ]
          }
        }
      }
    },
    {
      "if": { "type": "object", "properties": { "gate": { "const": "ACTIVATION" } }, "required": ["gate"] },
      "then": {
        "type": "object",
        "properties": {
          "legacyArtifactHashes": { "$ref": "#/$defs/activationLegacy" },
          "predecessor": { "$ref": "#/$defs/deploymentPredecessor" },
          "producer": {
            "allOf": [
              { "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/externalProducer" },
              { "type": "object", "properties": { "role": { "const": "activationGate" } } }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "admissionId", "envelopeSha256", "gate", "payloadSha256", "payloadType", "role",
        "rootKeyFingerprintSha256"
      ],
      "properties": {
        "admissionId": {
          "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/sha256"
        },
        "envelopeSha256": {
          "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/sha256"
        },
        "gate": { "enum": ["HOSTED", "DEPLOYMENT"] },
        "payloadSha256": {
          "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/sha256"
        },
        "payloadType": {
          "enum": [
            "application/vnd.platform.v1-brownfield-gate-admission.hosted.v1+json",
            "application/vnd.platform.v1-brownfield-gate-admission.deployment.v1+json"
          ]
        },
        "role": { "enum": ["hostedGate", "deploymentGate"] },
        "rootKeyFingerprintSha256": {
          "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/sha256"
        }
      }
    },
    "hostedPredecessor": {
      "allOf": [
        { "$ref": "#/$defs/predecessor" },
        { "type": "object", "properties": {
          "gate": { "const": "HOSTED" },
          "payloadType": { "const": "application/vnd.platform.v1-brownfield-gate-admission.hosted.v1+json" },
          "role": { "const": "hostedGate" }
        } }
      ]
    },
    "deploymentPredecessor": {
      "allOf": [
        { "$ref": "#/$defs/predecessor" },
        { "type": "object", "properties": {
          "gate": { "const": "DEPLOYMENT" },
          "payloadType": { "const": "application/vnd.platform.v1-brownfield-gate-admission.deployment.v1+json" },
          "role": { "const": "deploymentGate" }
        } }
      ]
    },
    "hostedLegacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostedFinalDeploymentAdmissionSha256", "hostedPreparationAuthorizationSha256",
        "hostedPreparationReceiptSha256"
      ],
      "properties": {
        "hostedFinalDeploymentAdmissionSha256": {
          "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/sha256"
        },
        "hostedPreparationAuthorizationSha256": {
          "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/sha256"
        },
        "hostedPreparationReceiptSha256": {
          "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/sha256"
        }
      }
    },
    "deploymentLegacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dastReceiptSha256", "deploymentAdmissionSha256", "stagingRuntimeReceiptSha256"],
      "properties": {
        "dastReceiptSha256": {
          "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/sha256"
        },
        "deploymentAdmissionSha256": {
          "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/sha256"
        },
        "stagingRuntimeReceiptSha256": {
          "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/sha256"
        }
      }
    },
    "activationLegacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activationPromotionSha256", "dockerAuthorizationSha256", "sigstoreBundleSha256"],
      "properties": {
        "activationPromotionSha256": {
          "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/sha256"
        },
        "dockerAuthorizationSha256": {
          "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/sha256"
        },
        "sigstoreBundleSha256": {
          "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/sha256"
        }
      }
    }
  }
}
