{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.invalid/schemas/v1-brownfield-application-data-cutover.schema.json",
  "title": "Verify-only V1 brownfield application-data cutover contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "documentId",
    "scope",
    "evidenceClass",
    "synthetic",
    "verifyOnly",
    "status",
    "baselineBinding",
    "runtimeBinding",
    "applicationDataParent",
    "writerInventory",
    "writerLifecycle",
    "queue",
    "preservationEvidence",
    "cutoverPlan",
    "safety"
  ],
  "properties": {
    "schema": { "const": "platform.v1-brownfield-application-data-cutover/v1" },
    "documentId": { "$ref": "#/$defs/sha256" },
    "scope": { "const": "platform-infrastructure" },
    "evidenceClass": {
      "enum": ["EXTERNAL-PENDING-TEMPLATE", "SYNTHETIC-TEST", "LIVE-READ-ONLY"]
    },
    "synthetic": { "type": "boolean" },
    "verifyOnly": { "const": true },
    "status": {
      "enum": ["EXTERNAL-PENDING", "BASELINE-BOUND-NOT-AUTHORIZED"]
    },
    "baselineBinding": { "$ref": "#/$defs/baselineBinding" },
    "runtimeBinding": { "$ref": "#/$defs/runtimeBinding" },
    "applicationDataParent": { "$ref": "#/$defs/applicationDataParent" },
    "writerInventory": { "$ref": "#/$defs/writerInventory" },
    "writerLifecycle": { "$ref": "#/$defs/writerLifecycle" },
    "queue": { "$ref": "#/$defs/queue" },
    "preservationEvidence": { "$ref": "#/$defs/preservationEvidence" },
    "cutoverPlan": { "$ref": "#/$defs/cutoverPlan" },
    "safety": { "$ref": "#/$defs/safety" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sha256OrNull": {
      "anyOf": [
        { "$ref": "#/$defs/sha256" },
        { "type": "null" }
      ]
    },
    "integerOrNull": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "booleanOrNull": {
      "type": ["boolean", "null"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "baselineBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "rawArtifactSha256",
        "baselineId",
        "complete",
        "effect",
        "sourceSetSchema",
        "sourceDeviceSetSha256",
        "sourceObservationSetSha256",
        "sourcePathSetSha256",
        "sourceObservationCount",
        "sourcePathCount",
        "applicationDataBindSetSha256",
        "writerSetSha256"
      ],
      "properties": {
        "schema": { "const": "platform.live-preservation-baseline/v1" },
        "rawArtifactSha256": { "$ref": "#/$defs/sha256OrNull" },
        "baselineId": { "$ref": "#/$defs/sha256OrNull" },
        "complete": { "$ref": "#/$defs/booleanOrNull" },
        "effect": { "const": "DENY-ONLY" },
        "sourceSetSchema": { "const": "platform.v1-persistent-source-set/v1" },
        "sourceDeviceSetSha256": { "$ref": "#/$defs/sha256OrNull" },
        "sourceObservationSetSha256": { "$ref": "#/$defs/sha256OrNull" },
        "sourcePathSetSha256": { "$ref": "#/$defs/sha256OrNull" },
        "sourceObservationCount": { "$ref": "#/$defs/integerOrNull" },
        "sourcePathCount": { "$ref": "#/$defs/integerOrNull" },
        "applicationDataBindSetSha256": { "$ref": "#/$defs/sha256OrNull" },
        "writerSetSha256": { "$ref": "#/$defs/sha256OrNull" }
      }
    },
    "queueConflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "legacyQueuePath",
        "runtimeLogicalVolume",
        "runtimeMountTarget",
        "resolutionStatus"
      ],
      "properties": {
        "status": { "const": "PRESERVE+STOP" },
        "reason": { "const": "NAMED-VOLUME-WOULD-HIDE-LEGACY-QUEUE-CHILD" },
        "legacyQueuePath": {
          "const": "/home/platform_infrastructure/platform-infrastructure/projects-portal/state/backup-jobs"
        },
        "runtimeLogicalVolume": { "const": "backup_scheduler_jobs" },
        "runtimeMountTarget": { "const": "/var/www/project-state/backup-jobs" },
        "resolutionStatus": { "const": "EXTERNAL-PROVIDER-EVIDENCE-REQUIRED" }
      }
    },
    "runtimeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "rawArtifactSha256",
        "documentId",
        "baselineBindingSha256",
        "consumerSetSha256",
        "applicationDataObservationArtifactSha256",
        "queueWriterEnumerationSha256",
        "compatibilityStatus",
        "currentContractsConverged",
        "applicationDataBaselineRecomputationStatus",
        "queueWriterEnumerationRecomputationStatus",
        "queueConflict"
      ],
      "properties": {
        "schema": { "const": "platform.v1-brownfield-runtime-identity/v1" },
        "rawArtifactSha256": { "$ref": "#/$defs/sha256OrNull" },
        "documentId": { "$ref": "#/$defs/sha256OrNull" },
        "baselineBindingSha256": { "$ref": "#/$defs/sha256OrNull" },
        "consumerSetSha256": { "$ref": "#/$defs/sha256OrNull" },
        "applicationDataObservationArtifactSha256": { "$ref": "#/$defs/sha256OrNull" },
        "queueWriterEnumerationSha256": { "$ref": "#/$defs/sha256OrNull" },
        "compatibilityStatus": { "const": "MISMATCH-STOP" },
        "currentContractsConverged": { "const": false },
        "applicationDataBaselineRecomputationStatus": {
          "const": "EXTERNAL_ROOT_CONSUMER_REQUIRED"
        },
        "queueWriterEnumerationRecomputationStatus": {
          "const": "EXTERNAL_ROOT_CONSUMER_REQUIRED"
        },
        "queueConflict": {
          "anyOf": [
            { "$ref": "#/$defs/queueConflict" },
            { "type": "null" }
          ]
        }
      }
    },
    "applicationDataParent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "sourcePath",
        "canonicalPath",
        "preservationScope",
        "excludedPaths",
        "baselineTargetIdentitySha256",
        "baselineParentContentSha256",
        "coveredBindSources",
        "coveredBindSetSha256",
        "relocationAllowed"
      ],
      "properties": {
        "classification": { "const": "APPLICATION-DATA" },
        "sourcePath": {
          "const": "/home/platform_infrastructure/platform-infrastructure/projects-portal/state"
        },
        "canonicalPath": {
          "const": "/home/platform_infrastructure/platform-infrastructure/projects-portal/state"
        },
        "preservationScope": { "const": "FULL-PARENT-RECURSIVE-INCLUSIVE" },
        "excludedPaths": {
          "type": "array",
          "maxItems": 0
        },
        "baselineTargetIdentitySha256": { "$ref": "#/$defs/sha256OrNull" },
        "baselineParentContentSha256": { "$ref": "#/$defs/sha256OrNull" },
        "coveredBindSources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^/home/platform_infrastructure/platform-infrastructure/projects-portal/state(?:/[^\\u0000\\r\\n]+)?$"
          }
        },
        "coveredBindSetSha256": { "$ref": "#/$defs/sha256OrNull" },
        "relocationAllowed": { "const": false }
      }
    },
    "writer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "writerId",
        "containerName",
        "project",
        "service",
        "sourcePath",
        "canonicalPath",
        "destination",
        "scope",
        "access",
        "applicationIds",
        "quiesceOrder",
        "quiesceRequired",
        "mapped"
      ],
      "properties": {
        "writerId": { "$ref": "#/$defs/sha256" },
        "containerName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "project": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "service": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "sourcePath": {
          "type": "string",
          "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000\\r\\n]*$"
        },
        "canonicalPath": {
          "type": "string",
          "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000\\r\\n]*$"
        },
        "destination": {
          "type": "string",
          "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000\\r\\n]*$"
        },
        "scope": { "enum": ["ANCESTOR", "PARENT", "DESCENDANT"] },
        "access": { "const": "RW" },
        "applicationIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"
          }
        },
        "quiesceOrder": { "type": "integer", "minimum": 1 },
        "quiesceRequired": { "const": true },
        "mapped": { "const": true }
      }
    },
    "writerInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "derivation",
        "complete",
        "writers",
        "writerSetSha256",
        "foreignWriters",
        "unmappedWriters",
        "foreignWriterDisposition",
        "unmappedWriterDisposition"
      ],
      "properties": {
        "derivation": {
          "const": "ALL-RW-BIND-CONSUMERS-OVERLAPPING-EXACT-PARENT"
        },
        "complete": { "type": "boolean" },
        "writers": {
          "type": "array",
          "items": { "$ref": "#/$defs/writer" }
        },
        "writerSetSha256": { "$ref": "#/$defs/sha256OrNull" },
        "foreignWriters": { "type": "array", "maxItems": 0 },
        "unmappedWriters": { "type": "array", "maxItems": 0 },
        "foreignWriterDisposition": { "const": "PRESERVE+STOP" },
        "unmappedWriterDisposition": { "const": "PRESERVE+STOP" }
      }
    },
    "writerDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "writerId",
        "containerName",
        "service",
        "preCutoverAccess",
        "finalDisposition",
        "runtimeAttachmentAccess",
        "runtimeAttachmentTarget",
        "resumeOrder",
        "resumeRequired",
        "targetReplacementProven"
      ],
      "properties": {
        "writerId": { "$ref": "#/$defs/sha256" },
        "containerName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "service": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "preCutoverAccess": { "const": "RW" },
        "finalDisposition": { "const": "RESUME-UNCHANGED-LEGACY-WRITER" },
        "runtimeAttachmentAccess": { "enum": ["RW", "RO", "NONE"] },
        "runtimeAttachmentTarget": {
          "enum": ["/var/www/project-state", null]
        },
        "resumeOrder": { "type": "integer", "minimum": 1 },
        "resumeRequired": { "const": true },
        "targetReplacementProven": { "const": false }
      }
    },
    "writerLifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quiesceWriterIds",
        "quiesceContainerNames",
        "finalDispositions",
        "resumeWriterIds",
        "resumeContainerNames",
        "writerDispositionSetSha256",
        "omittedWriterDisposition",
        "duplicateWriterDisposition"
      ],
      "properties": {
        "quiesceWriterIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sha256" }
        },
        "quiesceContainerNames": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          }
        },
        "finalDispositions": {
          "type": "array",
          "items": { "$ref": "#/$defs/writerDisposition" }
        },
        "resumeWriterIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sha256" }
        },
        "resumeContainerNames": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          }
        },
        "writerDispositionSetSha256": { "$ref": "#/$defs/sha256OrNull" },
        "omittedWriterDisposition": { "const": "PRESERVE+STOP" },
        "duplicateWriterDisposition": { "const": "PRESERVE+STOP" }
      }
    },
    "queue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourcePath",
        "preservationMode",
        "coveredByParent",
        "standaloneReplacementAllowed",
        "potentialWriterIds",
        "potentialWriterSetSha256"
      ],
      "properties": {
        "sourcePath": {
          "const": "/home/platform_infrastructure/platform-infrastructure/projects-portal/state/backup-jobs"
        },
        "preservationMode": { "const": "INCLUDED-IN-FULL-PARENT" },
        "coveredByParent": { "const": true },
        "standaloneReplacementAllowed": { "const": false },
        "potentialWriterIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sha256" }
        },
        "potentialWriterSetSha256": { "$ref": "#/$defs/sha256OrNull" }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactSha256",
        "capturedAt",
        "scopePath",
        "entryCount",
        "rootIdentitySha256",
        "metadataTreeSha256",
        "aclTreeSha256",
        "xattrTreeSha256",
        "contentTreeSha256",
        "combinedTreeSha256",
        "unreadableEntryCount",
        "volatileEntryCount"
      ],
      "properties": {
        "artifactSha256": { "$ref": "#/$defs/sha256" },
        "capturedAt": { "$ref": "#/$defs/timestamp" },
        "scopePath": {
          "const": "/home/platform_infrastructure/platform-infrastructure/projects-portal/state"
        },
        "entryCount": { "type": "integer", "minimum": 1 },
        "rootIdentitySha256": { "$ref": "#/$defs/sha256" },
        "metadataTreeSha256": { "$ref": "#/$defs/sha256" },
        "aclTreeSha256": { "$ref": "#/$defs/sha256" },
        "xattrTreeSha256": { "$ref": "#/$defs/sha256" },
        "contentTreeSha256": { "$ref": "#/$defs/sha256" },
        "combinedTreeSha256": { "$ref": "#/$defs/sha256" },
        "unreadableEntryCount": { "const": 0 },
        "volatileEntryCount": { "const": 0 }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preAttachSnapshotSha256",
        "postAttachSnapshotSha256",
        "rootIdentityMatch",
        "metadataMatch",
        "aclMatch",
        "xattrMatch",
        "contentMatch",
        "fullTreeMatch"
      ],
      "properties": {
        "preAttachSnapshotSha256": { "$ref": "#/$defs/sha256" },
        "postAttachSnapshotSha256": { "$ref": "#/$defs/sha256" },
        "rootIdentityMatch": { "const": true },
        "metadataMatch": { "const": true },
        "aclMatch": { "const": true },
        "xattrMatch": { "const": true },
        "contentMatch": { "const": true },
        "fullTreeMatch": { "const": true }
      }
    },
    "preservationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scopeMode",
        "digestContract",
        "copyPerformed",
        "relocationPerformed",
        "destinationPath",
        "sameFilesystemObjectRequired",
        "preAttachSnapshot",
        "postAttachSnapshot",
        "comparison"
      ],
      "properties": {
        "scopeMode": { "const": "FULL-PARENT-NO-EXCLUSIONS" },
        "digestContract": {
          "const": "SHA-256-CANONICAL-RELATIVE-PATH-RECORDS+FILE-TYPE+MODE+UID+GID+NLINK+ACL+XATTR+LINK-TARGET+CONTENT"
        },
        "copyPerformed": { "const": false },
        "relocationPerformed": { "const": false },
        "destinationPath": { "type": "null" },
        "sameFilesystemObjectRequired": { "const": true },
        "preAttachSnapshot": {
          "anyOf": [
            { "$ref": "#/$defs/snapshot" },
            { "type": "null" }
          ]
        },
        "postAttachSnapshot": {
          "anyOf": [
            { "$ref": "#/$defs/snapshot" },
            { "type": "null" }
          ]
        },
        "comparison": {
          "anyOf": [
            { "$ref": "#/$defs/comparison" },
            { "type": "null" }
          ]
        }
      }
    },
    "planStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "phase",
        "requires",
        "scopePath",
        "mode",
        "executor",
        "authorized",
        "completed"
      ],
      "properties": {
        "order": { "type": "integer", "minimum": 1, "maximum": 6 },
        "phase": { "enum": ["QUIESCE", "SNAPSHOT", "VERIFY", "ATTACH", "POST-VERIFY", "RESUME"] },
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["QUIESCE", "SNAPSHOT", "VERIFY", "ATTACH", "POST-VERIFY"] }
        },
        "scopePath": {
          "const": "/home/platform_infrastructure/platform-infrastructure/projects-portal/state"
        },
        "mode": {
          "enum": [
            "QUIESCE-EXACT-BASELINE-RW-WRITER-SET",
            "SNAPSHOT-EXACT-LEGACY-PARENT-NO-COPY",
            "VERIFY-PRE-ATTACH-METADATA-ACL-XATTR-CONTENT-TREES",
            "ATTACH-EXACT-LEGACY-PARENT-NO-RELOCATION",
            "POST-VERIFY-SAME-IDENTITY-AND-TREES",
            "RESUME-UNCHANGED-LEGACY-WRITERS"
          ]
        },
        "executor": { "const": "EXTERNAL-ROOT-CONSUMER-REQUIRED" },
        "authorized": { "const": false },
        "completed": { "const": false }
      }
    },
    "cutoverPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "steps", "executorAvailable", "executionAuthorized"],
      "properties": {
        "mode": { "const": "PROPOSAL-ONLY" },
        "steps": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "prefixItems": [
            {
              "const": {
                "order": 1,
                "phase": "QUIESCE",
                "requires": [],
                "scopePath": "/home/platform_infrastructure/platform-infrastructure/projects-portal/state",
                "mode": "QUIESCE-EXACT-BASELINE-RW-WRITER-SET",
                "executor": "EXTERNAL-ROOT-CONSUMER-REQUIRED",
                "authorized": false,
                "completed": false
              }
            },
            {
              "const": {
                "order": 2,
                "phase": "SNAPSHOT",
                "requires": ["QUIESCE"],
                "scopePath": "/home/platform_infrastructure/platform-infrastructure/projects-portal/state",
                "mode": "SNAPSHOT-EXACT-LEGACY-PARENT-NO-COPY",
                "executor": "EXTERNAL-ROOT-CONSUMER-REQUIRED",
                "authorized": false,
                "completed": false
              }
            },
            {
              "const": {
                "order": 3,
                "phase": "VERIFY",
                "requires": ["QUIESCE", "SNAPSHOT"],
                "scopePath": "/home/platform_infrastructure/platform-infrastructure/projects-portal/state",
                "mode": "VERIFY-PRE-ATTACH-METADATA-ACL-XATTR-CONTENT-TREES",
                "executor": "EXTERNAL-ROOT-CONSUMER-REQUIRED",
                "authorized": false,
                "completed": false
              }
            },
            {
              "const": {
                "order": 4,
                "phase": "ATTACH",
                "requires": ["QUIESCE", "SNAPSHOT", "VERIFY"],
                "scopePath": "/home/platform_infrastructure/platform-infrastructure/projects-portal/state",
                "mode": "ATTACH-EXACT-LEGACY-PARENT-NO-RELOCATION",
                "executor": "EXTERNAL-ROOT-CONSUMER-REQUIRED",
                "authorized": false,
                "completed": false
              }
            },
            {
              "const": {
                "order": 5,
                "phase": "POST-VERIFY",
                "requires": ["ATTACH", "QUIESCE", "SNAPSHOT", "VERIFY"],
                "scopePath": "/home/platform_infrastructure/platform-infrastructure/projects-portal/state",
                "mode": "POST-VERIFY-SAME-IDENTITY-AND-TREES",
                "executor": "EXTERNAL-ROOT-CONSUMER-REQUIRED",
                "authorized": false,
                "completed": false
              }
            },
            {
              "const": {
                "order": 6,
                "phase": "RESUME",
                "requires": ["ATTACH", "POST-VERIFY", "QUIESCE", "SNAPSHOT", "VERIFY"],
                "scopePath": "/home/platform_infrastructure/platform-infrastructure/projects-portal/state",
                "mode": "RESUME-UNCHANGED-LEGACY-WRITERS",
                "executor": "EXTERNAL-ROOT-CONSUMER-REQUIRED",
                "authorized": false,
                "completed": false
              }
            }
          ],
          "items": false
        },
        "executorAvailable": { "const": false },
        "executionAuthorized": { "const": false }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unknownResources",
        "preserveApplications",
        "preserveDatabases",
        "preservePersistentStorage",
        "deploymentAuthority",
        "executionAuthorized",
        "mutationAuthority",
        "localMutationAuthority",
        "executorAvailable",
        "dockerExecutor",
        "networkAuthority",
        "signingAuthority",
        "stdoutAuthority",
        "trustedNativeLauncherRequired",
        "rollbackAuthorized",
        "actions"
      ],
      "properties": {
        "unknownResources": { "const": "PRESERVE+STOP" },
        "preserveApplications": { "const": true },
        "preserveDatabases": { "const": true },
        "preservePersistentStorage": { "const": true },
        "deploymentAuthority": { "const": false },
        "executionAuthorized": { "const": false },
        "mutationAuthority": { "const": false },
        "localMutationAuthority": { "const": false },
        "executorAvailable": { "const": false },
        "dockerExecutor": { "const": false },
        "networkAuthority": { "const": false },
        "signingAuthority": { "const": false },
        "stdoutAuthority": { "const": false },
        "trustedNativeLauncherRequired": { "const": true },
        "rollbackAuthorized": { "const": false },
        "actions": { "type": "array", "maxItems": 0 }
      }
    }
  }
}
