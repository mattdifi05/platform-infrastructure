{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.example.invalid/schemas/v1-phase-b-install-journal-entry.schema.json",
  "title": "V1 Phase-B append-only INSTALLING journal entry bytes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "activationPerformed", "appendContract", "binding", "dataRollbackAuthority", "entryIdSha256",
    "previousArtifactSha256", "recordedAt", "resumeAllowed", "rollbackAttempted", "schema",
    "sequence", "state", "step"
  ],
  "properties": {
    "schema": { "const": "platform.v1-phase-b-install-journal-entry/v1" },
    "activationPerformed": { "const": false },
    "appendContract": { "$ref": "#/$defs/appendContract" },
    "binding": { "$ref": "#/$defs/binding" },
    "dataRollbackAuthority": { "const": false },
    "entryIdSha256": { "$ref": "#/$defs/sha256" },
    "previousArtifactSha256": { "$ref": "#/$defs/sha256" },
    "recordedAt": { "$ref": "#/$defs/timestamp" },
    "resumeAllowed": { "const": false },
    "rollbackAttempted": { "const": false },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 4096 },
    "state": { "const": "INSTALLING" },
    "step": { "$ref": "#/$defs/step" }
  },
  "$defs": {
    "sha256": { "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/sha256" },
    "nonce": { "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/nonce" },
    "identifier": { "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/identifier" },
    "opaqueIdentifier": { "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/opaqueIdentifier" },
    "absolutePath": { "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/absolutePath" },
    "timestamp": { "$ref": "urn:platform-infrastructure:schema:v1-brownfield-common-tuple:v1#/$defs/timestamp" },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputDigestSha256", "operation", "stepId", "targetPath"],
      "properties": {
        "inputDigestSha256": { "$ref": "#/$defs/sha256" },
        "operation": {
          "enum": [
            "CREATE_REQUIRED_DIRECTORY", "MATERIALIZE_PINNED_ARTIFACT",
            "VERIFY_MATERIALIZED_IDENTITY", "VERIFY_PRIVILEGE_POLICY",
            "VERIFY_POSTINSTALL_ANCESTRY", "VERIFY_RESOURCE_OUTCOME"
          ]
        },
        "stepId": { "$ref": "#/$defs/identifier" },
        "targetPath": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/absolutePath" }] }
      }
    },
    "appendContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appendOnlyRequired", "createdExclusiveRequired", "descriptorNoFollowRequired", "fileFsyncRequired",
        "noTruncateRequired", "openFlags", "parentFsyncRequired", "replacementAllowed"
      ],
      "properties": {
        "appendOnlyRequired": { "const": true },
        "createdExclusiveRequired": { "type": "boolean" },
        "descriptorNoFollowRequired": { "const": true },
        "fileFsyncRequired": { "const": true },
        "noTruncateRequired": { "const": true },
        "openFlags": {
          "oneOf": [
            {
              "type": "array", "prefixItems": [
                { "const": "O_CREAT" }, { "const": "O_EXCL" },
                { "const": "O_NOFOLLOW" }, { "const": "O_WRONLY" }
              ], "items": false, "minItems": 4, "maxItems": 4
            },
            {
              "type": "array", "prefixItems": [
                { "const": "O_APPEND" }, { "const": "O_NOFOLLOW" }, { "const": "O_WRONLY" }
              ], "items": false, "minItems": 3, "maxItems": 3
            }
          ]
        },
        "parentFsyncRequired": { "type": "boolean" },
        "replacementAllowed": { "const": false }
      }
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": [
        "authorizationEnvelopeSha256", "authorizationExpiresAt", "authorizationId", "authorizationIssuedAt",
        "claimId", "claimObjectPath", "journalParentIdentitySha256", "journalRecordPath", "journalStorePath",
        "ledgerEntryKeySha256", "ledgerId", "ledgerParentPath", "nonce", "packageBytesSha256",
        "packageInputObservationSha256", "packageManifestSha256", "policySha256",
        "preinstallTupleSha256", "receiptId", "receiptObjectKeySha256", "receiptObjectPath", "receiptStorePath", "transactionId"
      ],
      "properties": {
        "authorizationEnvelopeSha256": { "$ref": "#/$defs/sha256" },
        "authorizationExpiresAt": { "$ref": "#/$defs/timestamp" },
        "authorizationId": { "$ref": "#/$defs/opaqueIdentifier" },
        "authorizationIssuedAt": { "$ref": "#/$defs/timestamp" },
        "claimId": { "$ref": "#/$defs/identifier" },
        "claimObjectPath": { "type": "string", "pattern": "^/var/lib/\\.platform-v1-phase-b-claim-[a-f0-9]{64}$" },
        "journalParentIdentitySha256": { "$ref": "#/$defs/sha256" },
        "journalRecordPath": { "type": "string", "pattern": "^/var/lib/platform-infrastructure/v1-phase-b-ledger/[a-f0-9]{64}\\.json$" },
        "journalStorePath": { "const": "/var/lib/platform-infrastructure/v1-phase-b-ledger" },
        "ledgerEntryKeySha256": { "$ref": "#/$defs/sha256" },
        "ledgerId": { "const": "platform-v1-phase-b-installer-ledger" },
        "ledgerParentPath": { "const": "/var/lib" },
        "nonce": { "$ref": "#/$defs/nonce" },
        "packageBytesSha256": { "$ref": "#/$defs/sha256" },
        "packageInputObservationSha256": { "$ref": "#/$defs/sha256" },
        "packageManifestSha256": { "$ref": "#/$defs/sha256" },
        "policySha256": { "$ref": "#/$defs/sha256" },
        "preinstallTupleSha256": { "$ref": "#/$defs/sha256" },
        "receiptId": { "$ref": "#/$defs/opaqueIdentifier" },
        "receiptObjectKeySha256": { "$ref": "#/$defs/sha256" },
        "receiptObjectPath": { "type": "string", "pattern": "^/var/lib/platform-infrastructure/v1-install-receipts/sha256/[a-f0-9]{64}\\.json$" },
        "receiptStorePath": { "const": "/var/lib/platform-infrastructure/v1-install-receipts/sha256" },
        "transactionId": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
