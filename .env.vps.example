# Copy this file over/into .env on the VPS, then replace every example domain.
# TLS/certificates are expected at the VPS/edge/CDN layer, not inside Docker.

TRAEFIK_HTTP_BIND=80
WAF_HTTP_BIND=0.0.0.0:80
WAF_BACKEND=http://traefik:80
WAF_BLOCKING_PARANOIA=2
WAF_DETECTION_PARANOIA=2
WAF_ANOMALY_INBOUND=5
WAF_ANOMALY_OUTBOUND=4
TRAEFIK_ACME_EMAIL=ops@example.com

PLATFORM_NAME=Platform Infrastructure
PROJECT_NAME=platform
PLATFORM_NETWORK_PREFIX=platform_infra_vps
PLATFORM_CERTS_DIR=./traefik/certs
HOSTED_WORKLOAD_CATALOG=./config/hosted-workloads.example.json
HOSTED_WORKLOAD_ROOT=../src
# Use an absolute deployment-owned 0700 directory; never projects-portal/state.
HOSTED_WORKLOAD_LOCK=
HOSTED_WORKLOAD_MODE=no-hosted
DOCKER_SOCKET_PROXY_IMAGE=ghcr.io/tecnativa/docker-socket-proxy:v0.4.2@sha256:1f3a6f303320723d199d2316a3e82b2e2685d86c275d5e3deeaf182573b47476
DOCKER_SOCKET_PROXY_PORT=2376
DOMAIN=example.com
LOCAL_DOMAIN=example.com
PROVIDER_PROFILE=generic-vps
ADMIN_HOST=portal.example.com
CONTROL_CENTER_HOST=portal.example.com
DOCS_HOST=docs.example.com
AUTH_HOST=auth.example.com
STORAGE_HOST=storage.example.com
MINIO_CONSOLE_HOST=storage.example.com
GRAFANA_HOST=grafana.example.com
PROJECTS_HOST=
PROJECTS_WILDCARD_HOST_REGEXP=
PROJECT_HOST_SUFFIX=.example.com
CONTROL_CENTER_ENV=production
CONTROL_CENTER_AUTH_MODE=oidc-passkey
CONTROL_CENTER_OIDC_CLIENT_ID=platform-control-center
CONTROL_CENTER_OIDC_REQUIRED_ACR=urn:platform:loa:passkey
CONTROL_CENTER_OIDC_REQUIRED_AMR=webauthn
CONTROL_CENTER_SESSION_POLICY_VERSION=1
CONTROL_CENTER_SESSION_MAX_AGE_SECONDS=900
CONTROL_CENTER_FRESH_AUTH_SECONDS=300
CONTROL_CENTER_LOGIN_MAX_ATTEMPTS=20
CONTROL_CENTER_DATABASE_URL_SECRET_FILE=./secrets/control_center_database_url.txt
CONTROL_CENTER_VAULT_KEYS_SECRET_FILE=./secrets/control_center_vault_keys.txt
CONTROL_CENTER_VAULT_ACTIVE_KEY_ID=
CONTROL_CENTER_DISCOVER_HOSTED_PROJECTS=false
CONTROL_CENTER_DOCKER_STATS_MAX_AGE_SECONDS=15
NODE_PROJECT_HOSTS=
NODE_PROJECT_UPSTREAMS=
PROJECT_ROUTER_ALLOWED_UPSTREAMS=control-center:8080
NODE_PROJECT_COMMANDS=
NODE_PROJECT_ENV=production

KEYCLOAK_HOSTNAME=auth.example.com
KEYCLOAK_HOSTNAME_STRICT=true

AUTH_PUBLIC_URL=https://auth.example.com
STORAGE_PUBLIC_URL=https://storage.example.com
GRAFANA_PUBLIC_URL=https://grafana.example.com
CONTROL_CENTER_PUBLIC_URL=https://portal.example.com
DOCS_PUBLIC_URL=https://docs.example.com
KEYCLOAK_ISSUER=http://keycloak:8080/realms/platform

MAILER_PROVIDER=smtp
MAILER_FROM=no-reply@example.com
MAILER_REPLY_TO=no-reply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@example.com
SMTP_PASSWORD_FILE=/run/secrets/smtp_password
ALERT_EMAIL_TO=ops@example.com
ALERTMANAGER_SECRET_GID=1000
PROJECTS_GATEWAY_EMAIL=ops@example.com

MARIADB_ROOT_PASSWORD_SECRET_FILE=./secrets/mariadb_root_password.txt
