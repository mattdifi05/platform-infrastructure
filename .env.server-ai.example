# Copy locally on the target host and replace placeholders after review.
SERVER_AI_MACHINE_ID=REPLACE_WITH_SHA256_HOST_MACHINE_ID
SERVER_AI_DOCKER_GID=REPLACE_WITH_NUMERIC_DOCKER_GROUP_ID
SERVER_AI_OBSERVER_PROXY_GID=REPLACE_WITH_NUMERIC_PROXY_SOCKET_GROUP_ID
SERVER_AI_SEARXNG_CONFIG_DIR=/REPLACE/WITH/OPERATOR/GENERATED/searxng-config
SERVER_AI_SEARXNG_SETTINGS_FILE=/REPLACE/WITH/OPERATOR/GENERATED/searxng-settings.yml
SERVER_AI_CONTROLLER_REGISTRY_FILE=/REPLACE/WITH/ROOT-OWNED/controller-registry.json
SERVER_AI_CONTROLLER_SOCKET_DIR=/REPLACE/WITH/PRIVATE/controller-socket
SERVER_AI_OBSERVER_TOKEN_FILE=/REPLACE/WITH/PRIVATE/server-ai-observer-token
SERVER_AI_PROJECT_READERS_TOKEN_FILE=/REPLACE/WITH/PRIVATE/server-ai-project-readers-token
SERVER_AI_PROJECTS_ROOT=/REPLACE/WITH/APPROVED/PROJECTS/ROOT
SERVER_AI_PLATFORM_SOURCE_PATH=/var/lib/platform-infrastructure/server-ai-REPLACE-WITH-ID/repo
SERVER_AI_DB_TLS_DIR=/REPLACE/WITH/OPERATOR/GENERATED/db-tls-clients
SERVER_AI_DB_FIPLATFORM_FIP_CREDENTIAL_FILE=/REPLACE/WITH/PRIVATE/reader-db-credential-01.json
SERVER_AI_DB_FIPLATFORM_U778675014_FIP_CREDENTIAL_FILE=/REPLACE/WITH/PRIVATE/reader-db-credential-02.json
SERVER_AI_DB_WORKCALENDAR_CREDENTIAL_FILE=/REPLACE/WITH/PRIVATE/reader-db-credential-03.json
SERVER_AI_DB_ANNIVERSARY_CREDENTIAL_FILE=/REPLACE/WITH/PRIVATE/reader-db-credential-04.json
SERVER_AI_DB_STREAM_CREDENTIAL_FILE=/REPLACE/WITH/PRIVATE/reader-db-credential-05.json
SERVER_AI_DB_ACCOUNT_POSTGRES_CREDENTIAL_FILE=/REPLACE/WITH/PRIVATE/reader-db-credential-06.json
SERVER_AI_OPENAI_API_KEY_FILE=/REPLACE/WITH/PRIVATE/server_ai_openai_api_key
# Existing Control Center service overlay inputs (paths only; never key material).
SERVER_AI_MACHINE_REGISTRY_SOURCE=/REPLACE/WITH/OPERATOR/GENERATED/machine-registry.json
SERVER_AI_ADMIN_HMAC_TOKEN_SOURCE=/REPLACE/WITH/PRIVATE/server-admin-hmac-token
SERVER_AI_ADMIN_SOCKET_SOURCE=/run/platform-server-ai-admin
